# Rockchip RK3528 quad core 1-8GB SoC WIFI/BT  eMMC USB
BOARD_NAME="Hugsun X88pro"
BOARD_VENDOR="rockchip"
BOARDFAMILY="rk35xx"
BOARD_MAINTAINER="joilg"
INTRODUCED="2026"
KERNEL_TARGET="vendor,current,edge"
IMAGE_PARTITION_TABLE="gpt"
COMPRESS_OUTPUTIMAGE=xz

FULL_DESKTOP="yes"

#RELEASE="trixie"
#DESKTOP_ENVIRONMENT="xfce"
#DESKTOP_TIER="mid"

BOOT_LOGO="desktop"
#BOOTCONFIG="x88pro_rk3528_defconfig"
#BOOTCONFIG="hinlink_rk3528_defconfig"
BOOTCONFIG="rock-2-rk3528_defconfig"
BOOT_FDT_FILE="rockchip/rk3528-x88pro.dtb"
# BOOT_FDT_FILE="rockchip/rk3528-h96max.dtb"
BOOT_SCENARIO="spl-blobs"
DEFAULT_CONSOLE="serial"
SERIALCON="ttyS0"

#SRC_CMDLINE="rootwait rootfstype=ext4 console=ttyS0,1500000 console=tty1 loglevel=7"
#SRC_CMDLINE="rootwait rootfstype=ext4 earlycon=uart8250,mmio32,0xff9f0000 console=ttyS0,1500000 console=tty1 loglevel=7"

# Same RK3528 DDR/BL31 blobs used by the native ROCK 2A/2F definitions.
DDR_BLOB="rk35/rk3528_ddr_1056MHz_v1.14.bin"
BL31_BLOB="rk35/rk3528_bl31_v1.21.elf"

PACKAGE_LIST_BOARD="rfkill bluetooth bluez bluez-tools"

enable_extension "ea6x21-dkms"			# vendor only
enable_extension "rk-remotectrl"
enable_extension "swt6621s-dkms"
enable_extension "ea6x21q"				# only on current and edge

# AIC8800D80 WiFi on SDIO, Bluetooth on UART
AIC8800_TYPE="sdio"
AIC8800_SDIO_BT="yes"
AIC8800_MODPROBE_OPTIONS="options aic8800_fdrv_sdio aicwf_dbg_level=0 custregd=0 ps_on=0"
enable_extension "radxa-aic8800"

# Apply board CPU settings and mainline U-Boot configuration.
function post_family_config__x88pro_mainline() {
	case "${BRANCH}" in
		current | edge)
			declare -g GOVERNOR="performance"
			declare -g CPUBOOST="true"
			display_alert "$BOARD" "Using mainline U-Boot for X88PRO / ${BRANCH}" "info"
			declare -g BOOTSCRIPT='boot-rockchip64-ttyS0.cmd:boot.cmd'
			declare -g SERIALCON="ttyS0"
			declare -g BOOTDELAY=5
			declare -g BOOTSOURCE="https://github.com/u-boot/u-boot.git"
			declare -g BOOTBRANCH="tag:v2026.10"
			declare -g BOOTPATCHDIR="v2026.10"
			declare -g BOOTDIR="u-boot-${BOARD}"
			declare -g UBOOT_TARGET_MAP="BL31=${RKBIN_DIR}/${BL31_BLOB} ROCKCHIP_TPL=${RKBIN_DIR}/${DDR_BLOB};;u-boot-rockchip.bin"
			;;
	esac
	display_alert "$BOARD" "post_family_config:  Using ${BOOT_FDT_FILE} and SERIALCON=${SERIALCON} for ${BRANCH}" "info"
}

